generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify OAuth session storage (@shopify/shopify-app-session-storage-prisma).
// Field names must match the adapter's expected shape; columns are snake_cased
// for consistency with the rest of the schema.
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false) @map("is_online")
  scope               String?
  expires             DateTime?
  accessToken         String    @map("access_token")
  userId              BigInt?   @map("user_id")
  firstName           String?   @map("first_name")
  lastName            String?   @map("last_name")
  email               String?
  accountOwner        Boolean   @default(false) @map("account_owner")
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false) @map("email_verified")
  // Token a scadenza: dal 1 aprile 2026 Shopify rifiuta i token perpetui per le
  // app nuove. L'access token vive un'ora e viene rinnovato con il refresh token,
  // che la libreria usa da sola quando mancano meno di 5 minuti alla scadenza.
  refreshToken        String?   @map("refresh_token")
  refreshTokenExpires DateTime? @map("refresh_token_expires")

  @@map("sessions")
}

model Shop {
  id                String    @id @default(uuid())
  shopDomain        String    @unique @map("shop_domain")
  accessToken       String    @map("access_token")
  scopes            String
  // Nessun default: il piano iniziale si legge dal listino (freePlanName), cosi'
  // rinominare un piano non lascia indietro i negozi nuovi. Sul database c'e'
  // una foreign key verso plans.plan_name che rifiuta i nomi fuori listino.
  currentPlan       String    @map("current_plan")
  activeChargeId    String?   @map("active_charge_id")
  trialEndsAt       DateTime? @map("trial_ends_at")
  isInTrial         Boolean   @default(true) @map("is_in_trial")
  planStartedAt     DateTime? @map("plan_started_at")
  // Quando il merchant ha confermato il piano dal passo della configurazione.
  // Distinto da planStartedAt, che segna l'attivazione di un abbonamento:
  // confermare il piano che si ha gia' non attiva niente, ma chiude un passo.
  // Confrontato con connectionVerifiedAt dice se la conferma vale per il
  // collegamento di adesso o per uno precedente.
  planConfirmedAt   DateTime? @map("plan_confirmed_at")
  // Quando il controllo delle altre fonti di eventi ha dato una risposta.
  // Anche questo confrontato con connectionVerifiedAt: dice se il controllo
  // vale per il collegamento di adesso. Senza, il passo risultava da fare a
  // ogni apertura dell'app — la risposta arriva da una richiesta al browser, e
  // il browser riparte da zero ogni volta.
  trackingCheckedAt DateTime? @map("tracking_checked_at")
  // Lingua scelta dal merchant. null = si segue quella del suo admin Shopify,
  // che e' il comportamento normale: la lingua non si chiede, la si eredita.
  // Una scelta esplicita invece vince sempre. Contiene la sola lingua ("it",
  // "en"); i valori "en-US"/"en-GB" salvati quando lingua e valuta erano una
  // scelta sola si leggono ancora, e portano con se' la loro valuta.
  locale            String?
  // Quando la configurazione e' arrivata in fondo la prima volta.
  //
  // Da quel momento non ci si torna piu': cambiare database o piano non
  // rimanda a rifare i passi, che e' quel che succedeva finche' lo stato si
  // ricalcolava ogni volta dai dati. Si azzera solo scollegando l'account, che
  // e' l'unico gesto che riporta il negozio al punto di partenza.
  setupCompletedAt  DateTime? @map("setup_completed_at")
  // Valuta scelta dal merchant, indipendente dalla lingua: un negozio olandese
  // legge in inglese e paga in euro, e prima non poteva dirlo. null = si usa
  // quella che di solito accompagna la sua lingua.
  preferredCurrency String?   @map("preferred_currency")

  // La valuta con cui il negozio vende ai suoi clienti: e' quella in cui sono
  // scritti i prezzi in `products`, e non coincide con nessuna delle altre due
  // — `billingCurrency` e' quella con cui il merchant paga noi,
  // `preferredCurrency` e' quella che ha scelto di leggere nelle card.
  // Serve al feed: Meta vuole la valuta accanto a ogni prezzo, e senza rifiuta
  // il file intero invece della singola riga.
  shopCurrency          String?            @map("shop_currency")
  // L'ultima lingua che Shopify ci ha dichiarato per questo admin. La manda in
  // coda alla URL a ogni apertura, ma non alle navigazioni interne: senza
  // ricordarla, a meta' sessione l'app cambierebbe lingua da sola.
  detectedLocale        String?            @map("detected_locale")
  // Valuta in cui Shopify fattura QUESTO merchant, dichiarata da lui
  // (shopBillingPreferences): non e' quella con cui vende ai suoi clienti. La
  // si usa per prezzi e addebiti solo se il listino esiste per intero in quella
  // valuta (vedi lib/billing/currency), altrimenti si resta alla valuta base —
  // il dollaro, la sola che la scheda dell'App Store accetti.
  billingCurrency       String?            @map("billing_currency")
  billingCycle          String?            @map("billing_cycle")
  installedAt           DateTime           @default(now()) @map("installed_at")
  uninstalledAt         DateTime?          @map("uninstalled_at")
  // Autorizzazione all'uso dell'app, gestita manualmente dall'owner su Supabase:
  // ENABLED (uso normale), PENDING (trial scaduto: tutto sospeso, banner warning),
  // DISABLED (ban: tutto bloccato, banner danger, fatturazione sospesa).
  // Enum e non testo libero: il Table Editor di Supabase mostra i soli valori
  // ammessi e un refuso diventa impossibile a livello di database.
  authorization         AuthorizationState @default(ENABLED)
  // Autorizzazione al TRACCIAMENTO, indipendente da quella sopra: un negozio a
  // cui l'app e' sospesa puo' continuare a leggere i dati gia' sincronizzati
  // (fermi, ma utilizzabili), e viceversa si puo' fermare il solo tracciamento
  // lasciando l'app in funzione. Spegnere una non spegne l'altra.
  trackingAuthorization AuthorizationState @default(ENABLED) @map("tracking_authorization")
  // Fuso orario IANA del negozio (es. Europe/Rome), letto da Shopify e
  // memorizzato: rende le date del log identiche su server e client.
  ianaTimezone          String?            @map("iana_timezone")
  // Dominio principale del negozio, quello su cui navigano i clienti (es.
  // negozio.it). Coincide con shopDomain finche' non ne viene collegato uno
  // proprio. Si ricontrolla all'apertura dell'app e si aggiorna se cambia.
  primaryDomain         String?            @map("primary_domain")
  // Piano con cui e' stata eseguita l'ultima sync completata. Confrontandolo con
  // currentPlan si capisce se il piano e' cambiato e c'e' altro da sincronizzare.
  lastSyncedPlan        String?            @map("last_synced_plan")
  // Istante in cui il banner di cambio piano e' stato mostrato la prima volta:
  // garantisce che non riappaia dopo la chiusura dell'app.
  planBannerShownAt     DateTime?          @map("plan_banner_shown_at")

  // Dove sta il negozio nel suo ciclo di vita: 'active' oppure 'erasing'.
  //
  // 'erasing' si scrive PRIMA di cominciare a cancellare, e in una scrittura
  // sua che non fa parte della transazione: chi legge questa colonna deve
  // vederla cambiata mentre la cancellazione e' ancora in corso, non alla fine.
  // Da quel momento la policy delle capacita' nega tutto — sincronizzazioni,
  // lettura dal proxy, notifiche in ingresso — perche' scrivere nel database
  // di un merchant che ha chiesto di essere dimenticato, un istante dopo che la
  // cancellazione e' cominciata, e' esattamente il modo di non averlo mai
  // dimenticato.
  //
  // Se la transazione fallisce la colonna RESTA su 'erasing', ed e' voluto: il
  // negozio e' in attesa di cancellazione, e riaprirlo al lavoro nel frattempo
  // vorrebbe dire riscrivere quel che il ritentativo dovra' togliere.
  lifecycleStatus       String             @default("active") @map("lifecycle_status")

  // Cresce a ogni inizio di cancellazione, e non riparte mai da zero.
  //
  // E' il gettone del ciclo di vita, gemello di `shop_locks.fencing_token`: una
  // corsa partita prima dell'inizio della cancellazione se lo porta dietro e lo
  // riverifica un istante prima di ogni scrittura sul database del merchant. Se
  // e' cambiato, quella corsa non ha piu' titolo per scrivere e si ferma —
  // senza questo, una sincronizzazione lunga avviata un minuto prima
  // continuerebbe a riempire di dati un negozio gia' cancellato.
  erasureGeneration     Int                @default(0) @map("erasure_generation")

  // Quando abbiamo chiesto a Shopify come stanno davvero le cose per questo
  // negozio: se l'app risulta ancora installata e quale abbonamento e' attivo.
  //
  // Serve a far ruotare la riconciliazione. Un webhook amministrativo perso
  // fuori dalla finestra dei ritentativi non torna piu': l'unico modo di
  // accorgersene e' andare a guardare, e andare a guardare costa due chiamate a
  // Shopify per negozio. Senza questa colonna il giro del cron ripasserebbe
  // ogni volta dagli stessi primi negozi e agli ultimi non arriverebbe mai.
  shopifyStateCheckedAt DateTime? @map("shopify_state_checked_at")

  // Il metafield del cliente da cui leggere la data di nascita, scelto dal
  // merchant nella tab Clienti. Vuoto = nessuno, e la colonna `date_of_birth`
  // sul suo database resta com'e'.
  //
  // Due colonne e non una stringa "custom.data_di_nascita": la query di Shopify
  // vuole namespace e chiave separati, quindi con un campo solo ogni lettura
  // dovrebbe rifare la divisione — e una riga scritta male si scoprirebbe al
  // momento della sincronizzazione, invece che quando il merchant la salva.
  // Divisa una volta all'ingresso, chi legge trova due valori gia' buoni.
  birthdateMetafieldNamespace String? @map("birthdate_metafield_namespace")
  birthdateMetafieldKey       String? @map("birthdate_metafield_key")

  // Token-proxy per le letture di tracciamento (Stape/GTM). Persistito solo come
  // hash (lookup) + cifrato (per mostrarlo in Impostazioni), mai in chiaro.
  readProxyTokenHash String? @unique @map("read_proxy_token_hash")
  readProxyTokenEnc  String? @map("read_proxy_token_enc")

  // Listino riservato: a quale partner appartiene il negozio (agenzia con cui
  // collaboriamo, oppure i clienti diretti) e per quanti cicli di fatturazione
  // vale il prezzo agevolato. null = nessuno sconto / per sempre.
  // Il riferimento e' il NOME del partner, non un id opaco: la riga si legge
  // ("webeing") mentre la si modifica a mano nel Table Editor, che e' come la
  // si assegna. Stessa scelta gia' fatta per shops.current_plan → plans.plan_name.
  partnerName       String? @map("partner_name")
  discountIntervals Int?    @map("discount_intervals")

  partner                  Partner?                     @relation(fields: [partnerName], references: [name], onDelete: SetNull, onUpdate: Cascade)
  supabaseConfig           SupabaseConfig?
  supabaseOAuthToken       SupabaseOAuthToken?
  billingCharges           BillingCharge[]
  syncJobs                 SyncJob[]
  eligibilitySnapshots     ProductEligibilitySnapshot[]
  customerDataAccessLogs   CustomerDataAccessLog[]
  dismissedTrackingSources DismissedTrackingSource[]
  trackingSetup            TrackingSetup?
  productFeeds             ProductFeed[]
  feedFieldMappings        FeedFieldMapping[]
  complianceRequests       ComplianceRequest[]
  supabaseManagedResources SupabaseManagedResource[]
  supabaseDataDeletions    SupabaseDataDeletion[]
  syncRequests             SyncRequest[]
  syncRepairs              SyncRepair[]
  webhookEvents            WebhookEvent[]
  consentRevocations       ConsentRevocation[]
  productScope             ProductScopeEntry[]

  @@index([shopDomain])
  @@map("shops")
}

/// Cosa il merchant ha risposto sull'infrastruttura server side, e per quali
/// piattaforme raccoglie dati.
///
/// Una riga per negozio: e' una risposta, non uno storico. Se cambia idea si
/// riscrive, perche' quella che conta e' l'ultima.
model TrackingSetup {
  shopId     String   @id @map("shop_id")
  /// 'needs' = ha chiesto un'infrastruttura, 'has' = dichiara di averla gia'.
  answer     String
  /// Le piattaforme spuntate al momento della risposta, per nome.
  platforms  String[]
  answeredAt DateTime @default(now()) @map("answered_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("tracking_setups")
}

// Stati di autorizzazione di un negozio. Il tipo Postgres si chiama
// `authorization_state`; nota che la COLONNA `authorization` va sempre quotata
// nell'SQL scritto a mano, perche' AUTHORIZATION e' una parola riservata.
enum AuthorizationState {
  ENABLED
  PENDING
  DISABLED

  @@map("authorization_state")
}

model SupabaseConfig {
  id                     String    @id @default(uuid())
  shopId                 String    @unique @map("shop_id")
  supabaseUrl            String    @map("supabase_url")
  supabasePublicKey      String    @map("supabase_public_key")
  supabaseServiceRoleKey String    @map("supabase_service_role_key")
  supabaseProjectRef     String?   @map("supabase_project_ref")
  /// Nome del progetto come il merchant l'ha chiamato su Supabase: il ref e'
  /// una sigla, e in Impostazioni il nome e' quello che gli dice quale sia.
  supabaseProjectName    String?   @map("supabase_project_name")
  tableNameProducts      String    @default("products") @map("table_name_products")
  tableNameCustomers     String    @default("customers") @map("table_name_customers")
  // Nessun campo per "sincronizzazione attiva": e' automatica e sempre attiva
  // finche' il progetto e' collegato (vedi lib/sync/sync-active). La colonna
  // sync_enabled resta nel database, non la legge piu' nessuno.
  syncIntervalHours      Int       @default(24) @map("sync_interval_hours")
  connectionVerifiedAt   DateTime? @map("connection_verified_at")
  // Versione dello schema applicata al database del merchant. Quando l'app ne
  // pretende una piu' alta (LATEST_SCHEMA_VERSION), l'aggiornamento parte da
  // solo alla prima occasione utile — sincronizzazione o apertura della
  // dashboard — senza che il merchant debba toccare tabelle o reinstallare
  // nulla. 0 = collegamento anteriore a questo meccanismo.
  schemaVersion          Int       @default(0) @map("schema_version")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("supabase_configs")
}

/// Un piano: cosa concede, non quanto costa.
///
/// I prezzi stavano anche qui, in due colonne, e la stessa cifra stava in
/// `plan_prices` con la sua valuta. Due posti per lo stesso dato che nessun
/// vincolo teneva d'accordo: chi amministrava scriveva il dollaro nella tabella
/// per valuta, l'app leggeva la colonna qui, e il prezzo mostrato non era
/// quello scritto. Ora il listino sta tutto in `plan_prices` — una riga per
/// piano e valuta, dollaro compreso — e qui restano solo i limiti.
model Plan {
  id                    String   @id @default(uuid())
  planName              String   @unique @map("plan_name")
  maxProducts           Int?     @map("max_products")
  maxCustomers          Int?     @map("max_customers")
  maxSyncFrequencyHours Float    @map("max_sync_frequency_hours")
  customFieldsLimit     Int?     @map("custom_fields_limit")
  supportLevel          String   @map("support_level")
  customersSyncEnabled  Boolean  @default(false) @map("customers_sync_enabled")
  // I feed di catalogo verso le piattaforme pubblicitarie. Come la
  // sincronizzazione clienti: una funzione che il piano concede o no, e che
  // l'app dichiara in Account accanto alle altre.
  productFeedsEnabled   Boolean  @default(false) @map("product_feeds_enabled")
  // Giorni di prova prima che l'app passi automaticamente in PENDING (null = nessun limite).
  trialDays             Int?     @map("trial_days")
  createdAt             DateTime @default(now()) @map("created_at")

  prices PlanPrice[]

  @@map("plans")
}

/// Il listino in una valuta diversa da quella base.
///
/// I prezzi in `plans` sono in dollari, come la scheda dell'App Store, che
/// altre valute non ne accetta. Un negozio che Shopify fattura in sterline vede
/// e paga in sterline solo se qui ci sono i prezzi di TUTTI i piani a pagamento
/// in sterline: prezzi decisi, non convertiti al cambio del giorno — un prezzo
/// che cambia da solo fra la card e la fattura non e' un prezzo.
///
/// Finche' la tabella e' vuota tutti leggono e pagano in dollari, che e' anche
/// la sola configurazione in cui annuncio, app e fattura dicono la stessa
/// cifra.
///
/// I piani gratuiti non hanno bisogno di una riga: zero e' zero in ogni valuta.
model PlanPrice {
  id           String  @id @default(uuid())
  planName     String  @map("plan_name")
  /// Sigla ISO come la scrive Shopify: "USD", "GBP".
  currency     String
  priceMonthly Decimal @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal @map("price_yearly") @db.Decimal(10, 2)

  plan Plan @relation(fields: [planName], references: [planName], onDelete: Cascade, onUpdate: Cascade)

  @@unique([planName, currency])
  @@map("plan_prices")
}

/// Con chi e' in rapporto il negozio: un'agenzia con cui collaboriamo, oppure
/// noi direttamente. Serve a categorizzare e a decidere quale listino applicare.
model Partner {
  id        String   @id @default(uuid())
  /// Nome tecnico, usato nei riferimenti: "agenzia-rossi", "own_partner".
  name      String   @unique
  /// Nome per esteso, quello che si legge.
  label     String
  createdAt DateTime @default(now()) @map("created_at")

  shops      Shop[]
  planPrices PartnerPlanPrice[]

  @@map("partners")
}

/// Prezzo riservato di un piano per un partner.
///
/// Si registra il prezzo FINALE, quello che il merchant vede e paga (19 → 14):
/// e' cosi' che lo si decide, e una percentuale produrrebbe cifre con i decimali
/// invece di prezzi tondi. Lo sconto da comunicare a Shopify e' la differenza
/// col listino, calcolata al momento della sottoscrizione.
///
/// Cambiare questi valori NON tocca gli abbonamenti gia' attivi: quelli vivono
/// su Shopify con l'importo e la durata concordati allora. Il listino nuovo si
/// incontra solo cambiando piano.
model PartnerPlanPrice {
  id           String  @id @default(uuid())
  partnerName  String  @map("partner_name")
  planName     String  @map("plan_name")
  priceMonthly Decimal @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal @map("price_yearly") @db.Decimal(10, 2)

  partner Partner @relation(fields: [partnerName], references: [name], onDelete: Cascade, onUpdate: Cascade)

  @@unique([partnerName, planName])
  @@map("partner_plan_prices")
}

/// Fonti di eventi che il merchant ha dichiarato innocue.
///
/// Un canale puo' essere collegato solo per sincronizzare il catalogo, con il
/// tracciamento spento: in quel caso l'avviso e' rumore, e un avviso che non si
/// puo' far tacere si impara a ignorare — anche quando dice qualcosa di vero.
///
/// Si registra la sola identita' della fonte (tipo + nome), non il dettaglio di
/// dove si trovava: se domani lo stesso strumento ricompare altrove, resta
/// quello che il merchant ha gia' valutato.
model DismissedTrackingSource {
  id          String   @id @default(uuid())
  shopId      String   @map("shop_id")
  /// 'channel' oppure 'theme'.
  kind        String
  /// Nome dello strumento: "Meta", "Google Analytics 4", …
  name        String
  dismissedAt DateTime @default(now()) @map("dismissed_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, kind, name])
  @@map("dismissed_tracking_sources")
}

model BillingCharge {
  id                  String    @id @default(uuid())
  shopId              String    @map("shop_id")
  shopifyChargeId     BigInt?   @unique @map("shopify_charge_id")
  planType            String    @map("plan_type")
  price               Decimal?  @db.Decimal(10, 2)
  /// In che valuta e' quella cifra. Un importo senza valuta, sulla riga a cui
  /// si guarda quando un merchant chiede conto di un addebito, non risponde
  /// alla domanda. null = le righe scritte prima che gli addebiti portassero la
  /// valuta, che sono tutte in euro.
  currency            String?
  billingCycle        String?   @map("billing_cycle")
  status              String
  trialDays           Int       @default(7) @map("trial_days")
  trialEndsAt         DateTime? @map("trial_ends_at")
  confirmationUrl     String?   @map("confirmation_url")
  /// Il nonce con cui questo tentativo di sottoscrizione e' partito, lo stesso
  /// che viaggia firmato nella URL di ritorno. E' il legame fra la callback e
  /// il tentativo esatto che l'ha aperta: senza, al ritorno c'e' solo un
  /// charge_id, e "quale riga stiamo chiudendo" diventa una supposizione.
  /// Unico: un nonce appartiene a un tentativo solo, cosi' ritrovare la riga e'
  /// una lettura per chiave e non una ricerca con dei se.
  callbackNonce       String?   @unique @map("callback_nonce")
  /// Quando quel nonce e' stato speso. Monouso: una seconda callback con lo
  /// stesso nonce trova la riga gia' consumata e non riapplica niente.
  callbackNonceUsedAt DateTime? @map("callback_nonce_used_at")
  activatedAt         DateTime? @map("activated_at")
  cancelledAt         DateTime? @map("cancelled_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("billing_charges")
}

model SyncJob {
  id                 String    @id @default(uuid())
  shopId             String    @map("shop_id")
  jobType            String    @map("job_type")
  status             String
  startedAt          DateTime  @default(now()) @map("started_at")
  completedAt        DateTime? @map("completed_at")
  productsSynced     Int       @default(0) @map("products_synced")
  variantsSynced     Int       @default(0) @map("variants_synced")
  customersSynced    Int       @default(0) @map("customers_synced")
  // Conteggi dettagliati per categoria di evento. Stanno qui perché il dettaglio
  // vero (SyncJobEvent) viene troncato a 500 righe per categoria per job: senza
  // questi il modal non può scrivere "mostrate 500 di 3.412".
  productsAdded      Int       @default(0) @map("products_added")
  productsRemoved    Int       @default(0) @map("products_removed")
  customersAdded     Int       @default(0) @map("customers_added")
  customersUpdated   Int       @default(0) @map("customers_updated")
  customersSuspended Int       @default(0) @map("customers_suspended")
  errors             Json?

  /// Fin dove questa corsa ha diritto di dire di essere arrivata.
  ///
  /// Distinto da `startedAt`, e la distinzione e' tutto il punto: prima il
  /// confine incrementale era `startedAt` dell'ultima corsa con stato
  /// `completed`, e `completed` lo diventava anche una corsa che aveva ignorato
  /// una manciata di errori. Il confine scavalcava le risorse che nessuno era
  /// riuscito a scrivere e quelle risorse, se su Shopify nessuno le toccava
  /// piu', non venivano rilette mai piu'.
  ///
  /// Si scrive solo quando ogni lavoro critico e' riuscito oppure e' passato,
  /// nello stesso commit, a una riga di `sync_repairs`. Nullo su una corsa
  /// fallita: quella non ha spostato niente.
  watermarkAt DateTime? @map("watermark_at")

  /// Quante riparazioni questa corsa ha lasciato aperte. Zero e' `completed`;
  /// piu' di zero e' `completed_with_repairs`, che nell'interfaccia si legge
  /// come parziale finche' l'ultima non si chiude.
  repairsOpened Int @default(0) @map("repairs_opened")

  shop   Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  events SyncJobEvent[]

  @@index([shopId])
  @@index([status])
  @@index([startedAt(sort: Desc)])
  /// La lettura del confine a ogni corsa: l'ultima che se l'e' guadagnato.
  @@index([shopId, watermarkAt(sort: Desc)])
  @@map("sync_jobs")
}

model SupabaseOAuthToken {
  id           String   @id @default(uuid())
  shopId       String   @unique @map("shop_id")
  accessToken  String   @map("access_token")
  refreshToken String   @map("refresh_token")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("supabase_oauth_tokens")
}

model ProductEligibilitySnapshot {
  id            String   @id @default(uuid())
  shopId        String   @map("shop_id")
  // Giorno UTC dello snapshot: una riga per negozio per giorno.
  day           DateTime @map("day") @db.Date
  eligibleCount Int      @map("eligible_count")
  createdAt     DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, day])
  @@map("product_eligibility_snapshots")
}

model SyncJobEvent {
  id        String   @id @default(uuid())
  syncJobId String   @map("sync_job_id")
  // 'product'. Il valore 'customer' esiste solo su righe storiche: dei clienti
  // si tiene il solo conteggio, su SyncJob (vedi `count` in app/lib/sync/job-events.ts).
  entity    String
  // 'added' | 'removed'
  action    String
  shopifyId BigInt?  @map("shopify_id")
  variantId BigInt?  @map("variant_id")
  // Riga principale: titolo del prodotto.
  label     String
  // Riga secondaria: titolo della variante, oppure null.
  sublabel  String?
  createdAt DateTime @default(now()) @map("created_at")

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@map("sync_job_events")
}

// Registro degli accessi ai dati personali dei clienti.
//
// Ogni lettura della tabella customers attraverso il proxy lascia una riga qui:
// quale negozio, com'e' andata, quando. Serve a rispondere alla domanda "chi ha
// letto dati personali e quando", che Shopify pone fra i requisiti per i dati
// protetti dei clienti.
//
// Cosa NON ci finisce, ed e' la parte importante: nessun dato letto e nessuna
// query. Una search PostgREST puo' contenere un indirizzo email
// (?email_address=eq.…), quindi salvarla vorrebbe dire copiarsi addosso proprio
// il dato che il registro esiste per proteggere.
//
// I prodotti non passano di qui: non sono dati personali, e le vetrine li
// leggono a ogni pagina.
model CustomerDataAccessLog {
  id        String   @id @default(uuid())
  // Nullo quando il token non e' riconducibile a nessun negozio: il tentativo
  // va registrato lo stesso, ed e' anzi quello piu' interessante.
  shopId    String?  @map("shop_id")
  // Esito leggibile: 'allowed', 'denied_no_token', 'denied_invalid_token',
  // 'denied_not_configured', 'denied_suspended', 'denied_table',
  // 'denied_consent', 'upstream_error'.
  outcome   String
  // Lo status HTTP restituito al chiamante.
  status    Int
  createdAt DateTime @default(now()) @map("created_at")

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("customer_data_access_logs")
}

/**
 * Un feed di catalogo pubblicato verso una piattaforma.
 * Meta non si collega a niente: va a prendersi un file a un indirizzo, ogni
 * giorno, senza autenticarsi. Quell'indirizzo e' quindi pubblico per forza, e
 * l'unica cosa che lo protegge e' il token qui sotto — lungo, casuale, e
 * sostituibile in un clic quando il merchant sospetta che sia in giro.
 * Una riga per negozio e per piattaforma: rigenerare il token non crea un
 * secondo feed, riscrive questo. Il vecchio indirizzo smette di rispondere
 * nello stesso istante, che e' il motivo per cui esiste il pulsante.
 */
model ProductFeed {
  id       String @id @default(uuid())
  shopId   String @map("shop_id")
  /// 'meta' per ora. Il nome della piattaforma, non un id opaco: si legge
  /// mentre si guarda la tabella.
  platform String

  /// Il segreto che sta nell'indirizzo. Unico su tutta la tabella: la rotta
  /// pubblica cerca per questo e basta, senza sapere di quale negozio si tratti
  /// finche' non l'ha trovato.
  token String @unique

  /// 'xml' (RSS 2.0) oppure 'csv'. Meta legge entrambi.
  format  String  @default("xml")
  enabled Boolean @default(true)

  /// Quando Meta e' passata l'ultima volta, e quante volte in tutto. E' l'unico
  /// modo che il merchant ha di sapere se dall'altra parte qualcuno sta
  /// davvero leggendo: Meta non ci avvisa di niente.
  lastFetchedAt DateTime? @map("last_fetched_at")
  fetchCount    Int       @default(0) @map("fetch_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, platform])
  @@index([token])
  @@map("product_feeds")
}

/**
 * Come le colonne del catalogo del merchant diventano i campi di una
 * piattaforma.
 * Serve a Google, che a differenza di Meta non si accontenta di un titolo e un
 * prezzo: chiede una ventina di campi, alcuni con nomi che non somigliano a
 * niente su Shopify, e li rifiuta in blocco se uno e' scritto male. Il merchant
 * deve poter dire "il mio `mpn` e' lo SKU" senza che glielo si imponga.
 * `recent` tiene le ultime scelte fatte su QUESTO campo: chi mappa venti campi
 * cambia idea, torna indietro, e ritrovare le tre variabili gia' provate in
 * cima alla tendina vale piu' di qualunque ordinamento alfabetico.
 */
model FeedFieldMapping {
  id       String @id @default(uuid())
  shopId   String @map("shop_id")
  platform String
  /// Il campo della piattaforma: 'title', 'gtin', 'availability'.
  field    String
  /// La colonna del catalogo scelta per riempirlo.
  variable String

  /// Le ultime scelte su questo campo, dalla piu' recente. Al massimo cinque.
  recent String[] @default([])

  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, platform, field])
  @@index([shopId, platform])
  @@map("feed_field_mappings")
}

/// Una richiesta di conformita' arrivata da Shopify, presa in carico e non
/// ancora chiusa.
///
/// Esiste perche' i tre webhook obbligatori NON sono una chiamata sincrona.
/// Shopify tratta il 2xx come una ricevuta — "l'ho presa" — e taglia la
/// richiesta a cinque secondi; i dati della persona vanno consegnati al
/// titolare del negozio entro trenta giorni, per una via sua. Rispondere
/// leggendo tre tabelle e restituendo l'esportazione nel corpo era quindi
/// sbagliato due volte: nel canale e nei tempi.
///
/// Questa riga e' il punto durevole fra le due meta'. Il webhook la scrive e
/// risponde; il resto avviene dopo, con i suoi tentativi e la sua traccia. Se
/// la scrittura non riesce si risponde 5xx e Shopify ritenta: e' l'unico modo
/// onesto di dire "non l'ho presa".
model ComplianceRequest {
  id            String  @id @default(uuid())
  /// L'id che Shopify da' alla consegna (header X-Shopify-Webhook-Id). Unico:
  /// e' con questo che una seconda consegna della stessa richiesta viene
  /// riconosciuta come tale invece di produrre una seconda esportazione o una
  /// seconda cancellazione in corsa con la prima.
  webhookId     String  @unique @map("webhook_id")
  /// L'id della pratica lato Shopify (`data_request.id`), dove il payload ce
  /// l'ha. E' il secondo livello di deduplica, e serve nel caso che l'id della
  /// consegna cambi: la pratica resta quella.
  dataRequestId String? @map("data_request_id")
  /// 'customers/data_request' | 'customers/redact' | 'shop/redact'.
  topic         String
  shopDomain    String  @map("shop_domain")
  /// Risolto quando la richiesta viene lavorata, non quando arriva: la
  /// ricevuta non deve dipendere da una lettura in piu'. Null anche dopo, se
  /// il negozio non l'abbiamo mai avuto — o se shop/redact l'ha appena tolto.
  shopId        String? @map("shop_id")
  /// L'impronta della persona (vedi gdpr/audit.server): identifica la pratica
  /// senza scrivere l'id in chiaro una seconda volta.
  customerRef   String? @map("customer_ref")

  /// Il payload firmato, tenuto solo finche' serve a lavorarlo: si azzera
  /// quando la richiesta si chiude bene. Dentro c'e' l'id della persona, e una
  /// coda di richieste GDPR gia' eseguite che se lo conserva e' il posto meno
  /// adatto del mondo per tenerlo.
  ///
  /// Una richiesta finita in 'dead_letter' lo tiene, ed e' voluto: li' la
  /// richiesta di una persona vera e' ferma e aspetta qualcuno che la porti a
  /// termine a mano. Senza il payload quel qualcuno non saprebbe piu' di chi
  /// si tratta, e il diritto non esercitato peserebbe piu' del dato conservato
  /// qualche giorno in piu'.
  payload Json?

  /// 'queued' | 'processing' | 'completed' | 'failed' | 'dead_letter'.
  /// 'failed' e' un fallimento da ritentare; 'dead_letter' e' uno a cui non si
  /// riprova piu' da soli, e vuole qualcuno che lo guardi.
  status      String    @default("queued")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  receivedAt  DateTime  @default(now()) @map("received_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// L'esportazione pronta, per le sole richieste di accesso. Sta qui e non in
  /// un file su un indirizzo pubblico: si consegna dall'app, al merchant gia'
  /// autenticato, e scade da sola.
  export          Json?
  /// Quando l'esportazione smette di essere scaricabile e viene cancellata. Un
  /// termine c'e' perche' questa e' una copia in piu' dei dati di una persona,
  /// e una copia senza scadenza e' una copia per sempre.
  exportExpiresAt DateTime? @map("export_expires_at")
  /// Quando il merchant l'ha scaricata l'ultima volta. Serve a lui, per sapere
  /// se l'ha gia' fatto, e a noi, per dimostrare che la consegna e' avvenuta.
  downloadedAt    DateTime? @map("downloaded_at")

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  @@unique([shopDomain, dataRequestId])
  @@index([status, receivedAt])
  @@index([shopDomain, receivedAt(sort: Desc)])
  @@map("compliance_requests")
}

/// Cosa, nel database del merchant, e' roba nostra.
///
/// Nasce da un guasto preciso: lo scollegamento con "elimina tabelle e dati"
/// eseguiva `DROP TABLE` sui due nomi configurati (`products`, `customers`) e
/// basta. Le tabelle che l'app crea pero' sono cinque — ci sono anche `users`,
/// `orders` e `order_lines` — quindi la promessa fatta al merchant era falsa in
/// un verso; e nell'altro era pericolosa, perche' un nome configurato non dice
/// da nessuna parte che quella tabella l'abbiamo creata noi. Un negozio che
/// aveva gia' la sua `products`, con dentro il suo catalogo, se la vedeva
/// cancellare da un gesto che prometteva di togliere le NOSTRE tabelle.
///
/// Qui si scrive al collegamento, quando la risposta e' ancora conoscibile:
/// prima di eseguire la DDL si guarda quali tabelle esistono gia', e quelle
/// nascono con `createdByCoreWard = false`. Dopo non lo si potrebbe piu' dire —
/// la DDL e' CREATE TABLE IF NOT EXISTS, e una tabella presente non racconta
/// chi l'ha fatta.
///
/// Una riga per tabella e per progetto: ricollegare lo stesso negozio a un
/// database diverso non eredita la proprieta' del precedente.
model SupabaseManagedResource {
  id                String   @id @default(uuid())
  shopId            String   @map("shop_id")
  /// Il progetto Supabase a cui la riga si riferisce. Fa parte della chiave:
  /// la stessa `products` su due progetti diversi sono due cose diverse.
  projectRef        String   @map("project_ref")
  schemaName        String   @default("public") @map("schema_name")
  /// Nome della tabella cosi' com'e' nel database del merchant.
  resourceName      String   @map("resource_name")
  /// Per ora solo 'table'. C'e' come colonna e non come sottinteso perche' il
  /// giorno in cui l'app creera' anche una vista o una funzione, l'ordine con
  /// cui si eliminano non e' lo stesso.
  resourceKind      String   @default("table") @map("resource_kind")
  /// L'unica domanda che conta al momento dell'eliminazione. false = la tabella
  /// c'era gia', e' del merchant, non si tocca.
  createdByCoreWard Boolean  @map("created_by_coreward")
  /// Versione dello schema con cui la risorsa e' stata creata: dice quale DDL
  /// l'ha fatta, senza doverlo dedurre dalla data.
  schemaVersion     Int      @map("schema_version")
  createdAt         DateTime @default(now()) @map("created_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, projectRef, schemaName, resourceName])
  @@index([shopId, projectRef])
  @@map("supabase_managed_resources")
}

/// Un tentativo di eliminare i dati dal database del merchant.
///
/// Esiste perche' l'eliminazione ha tre momenti che prima non erano distinti:
/// e' cominciata, e' andata a buon fine, non e' riuscita. Il codice vecchio li
/// confondeva tutti in uno — qualunque errore diventava un `console.warn`, e
/// token e configurazione venivano cancellati lo stesso: da li' in poi l'app
/// non aveva piu' le credenziali per finire il lavoro, e il merchant aveva
/// letto "fatto".
///
/// Sopravvive alla configurazione, che a fine corsa viene cancellata: e' anche
/// il solo posto dove resta scritto che quel database e' stato svuotato.
model SupabaseDataDeletion {
  id          String    @id @default(uuid())
  shopId      String    @map("shop_id")
  projectRef  String    @map("project_ref")
  /// 'processing' | 'completed' | 'failed'. Finche' e' 'processing' il
  /// collegamento e' spento (connection_verified_at azzerato), quindi ne'
  /// sincronizzazioni ne' webhook scrivono mentre le tabelle spariscono.
  status      String    @default("processing")
  /// I nomi qualificati che il tentativo si prefiggeva di eliminare.
  resources   String[]
  /// Quelli che dopo il COMMIT risultavano ancora li'. Non vuoto = la verifica
  /// ha detto di no, e token e configurazione sono stati conservati.
  remaining   String[]
  lastError   String?   @map("last_error")
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId, startedAt(sort: Desc)])
  @@map("supabase_data_deletions")
}

/// Un lavoro in coda, su Postgres.
///
/// PERCHE' NON PIU' SU REDIS. La coda stava su BullMQ, ma su Vercel Free non
/// gira nessun Worker: il cron leggeva i job in attesa con `getJobs()` e
/// chiamava i processor direttamente. Nessuno prendeva possesso di niente,
/// quindi due drenaggi simultanei vedevano lo stesso job e lo lavoravano tutti
/// e due; su eccezione il job veniva RIMOSSO, quindi i tentativi e il backoff
/// configurati su BullMQ non li applicava nessuno e un errore di rete perdeva
/// il lavoro per sempre. Con la coda qui il possesso e' una riga aggiornata in
/// modo atomico, e il resto — tentativi, attesa, lettera morta — sono colonne
/// che sopravvivono alla morte dell'invocazione.
///
/// Il danno che tutto questo evita non e' un doppione innocuo: la corsa
/// completa finisce spazzando dal database del merchant le righe con
/// `synced_at` anteriore al proprio inizio. Due corse sovrapposte hanno due
/// istanti d'inizio diversi, e la piu' vecchia porta via le righe che la piu'
/// recente ha appena scritto. Non lascia errori: si vede dopo, come prodotti
/// mancanti.
model SyncRequest {
  id String @id @default(uuid())

  /// Il negozio a cui il lavoro appartiene. Nullo per i lavori che un negozio
  /// non ce l'hanno: `shop/redact` sta cancellando proprio quello.
  shopId String? @map("shop_id")

  /// Uno dei tipi noti (vedi `SYNC_REQUEST_TYPES`). Un tipo sconosciuto viene
  /// rifiutato all'accodamento con un allarme: prima restava in attesa per
  /// sempre e nessuno se ne accorgeva.
  type String

  /// Il minimo indispensabile per ritrovare il lavoro, mai il lavoro stesso.
  /// Per le richieste di conformita' e' il solo id della riga: il payload
  /// contiene l'id di una persona, e una coda non e' il posto dove tenerlo —
  /// chi lavora l'item va a rileggersi la riga, e cosi' vede lo stato vero
  /// invece di una fotografia scattata all'accodamento.
  payload Json?

  /// L'identita' della richiesta ai fini della deduplica: tipo + negozio +
  /// finestra temporale. Due clic ravvicinati sul pulsante, o il cron e un
  /// gesto manuale che chiedono la stessa cosa, producono un item solo.
  /// La finestra c'e' perche' una richiesta fatta piu' tardi e' una richiesta
  /// diversa, e fonderla in quella di prima vorrebbe dire ignorarla.
  dedupKey String @unique @map("dedup_key")

  /// 'queued' | 'processing' | 'completed' | 'dead_letter'.
  /// Non esiste 'failed': un tentativo andato male torna 'queued' con
  /// `nextAttemptAt` in avanti, perche' cosi' c'e' un posto solo da guardare
  /// per sapere cosa e' pronto. 'dead_letter' e' lo stato che smette di
  /// riprovare da solo e chiede che qualcuno guardi.
  status String @default("queued")

  attempts Int @default(0)

  /// Prima di questo istante l'item non si prende. E' il backoff.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")

  /// Chi possiede l'item adesso, e fino a quando. Solo il proprietario puo'
  /// dichiararlo concluso o riprogrammarlo; un lease scaduto e' riprendibile da
  /// chiunque, ed e' cosi' che un'invocazione morta a meta' non blocca la coda.
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")

  /// Cresce a ogni presa. Serve al deploy a meta' lavoro: il processo vecchio,
  /// che si risveglia dopo aver perso il lease, presenta un gettone inferiore a
  /// quello di chi e' subentrato e le sue scritture vengono rifiutate. Senza,
  /// dichiarerebbe completato un lavoro che sta facendo qualcun altro.
  ///
  /// `Int` e non `BigInt`: e' un contatore per riga, e una riga vive ore.
  fencingToken Int @default(0) @map("fencing_token")

  /// L'ultimo errore, redatto: niente token, niente chiavi, niente indirizzi
  /// email. Questa colonna la si legge in un log o in un pannello, e un
  /// messaggio d'errore e' il posto piu' facile del mondo dove far uscire un
  /// segreto senza accorgersene.
  lastError String? @map("last_error")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  shop Shop? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([shopId, status])
  @@map("sync_requests")
}

/// Il lucchetto per negozio, su Postgres.
///
/// Prima stava su Redis con una scadenza fissa di dieci minuti che nessuno
/// rinnovava, e — la parte grave — se Redis non rispondeva la corsa proseguiva
/// SENZA lucchetto: fail-open su operazioni che cancellano righe nel database
/// del merchant. Qui il lucchetto e' una riga: se Postgres non risponde non la
/// si prende, e chi non la prende non lavora. La sincronizzazione torna in
/// coda, che e' un ritardo; l'alternativa era una cancellazione senza
/// protezione, che e' una perdita di dati.
///
/// Sta su Postgres e non su un advisory lock perche' `DATABASE_URL` punta al
/// pooler di Supabase in transaction mode: li' una sessione non e' di nessuno
/// fra una query e l'altra, quindi `pg_advisory_lock` verrebbe preso su una
/// connessione e rilasciato — o non rilasciato — su un'altra. Una riga con una
/// scadenza non ha quel problema, e in piu' la si puo' guardare.
model ShopLock {
  shopId String @id @map("shop_id")

  /// Chi lo possiede: identifica l'invocazione, non il negozio. Il rilascio e'
  /// condizionato a questo, cosi' una corsa lenta il cui lucchetto e' scaduto
  /// non rilascia quello di chi e' subentrato.
  owner String

  /// Cresce a ogni presa, e non riparte da zero al rilascio. E' quello che
  /// ogni scrittura distruttiva verifica prima di partire: se il gettone non e'
  /// piu' il nostro, il lucchetto e' di qualcun altro e non si cancella niente.
  fencingToken Int @default(0) @map("fencing_token")

  acquiredAt DateTime @default(now()) @map("acquired_at")

  /// Rinnovata dal battito del cuore finche' il lavoro dura. Cosi' la scadenza
  /// puo' essere breve — un'invocazione morta libera il negozio in un minuto
  /// invece che in dieci — senza che un lavoro lungo si veda togliere il
  /// lucchetto da sotto i piedi.
  expiresAt DateTime @map("expires_at")

  /// Nessuna chiave esterna verso `shops`, di proposito: il lucchetto serve
  /// anche mentre il negozio viene cancellato (`shop/redact`), e una riga che
  /// sparisce a meta' di quel lavoro sarebbe il lucchetto che si apre da solo
  /// nel momento peggiore. Le righe scadute le toglie il cron.
  @@index([expiresAt])
  @@map("shop_locks")
}

/// Il lavoro di riparazione: una risorsa che la corsa non e' riuscita a
/// scrivere, e che non deve poter sparire.
///
/// PERCHE' ESISTE. Nei processor una quantita' di errori veniva registrata e
/// ignorata, e la corsa si dichiarava completata lo stesso. Il confine
/// incrementale della corsa successiva si calcolava dall'ultima corsa
/// completata: la risorsa saltata usciva dalla finestra e — se su Shopify
/// nessuno la toccava piu' — non veniva riletta mai piu'. Il difetto non si
/// vedeva il giorno stesso, diventava permanente, e nessun registro sapeva
/// dire quale riga fosse rimasta indietro.
///
/// PERCHE' UNA TABELLA E NON UN TIPO NUOVO NELLA CODA. `sync_requests` e' una
/// coda di lavori, e ogni suo item costa una presa, un lease e un battito: una
/// corsa che ne apre duecento vorrebbe dire duecento prese. In piu' la sua
/// `dedup_key` e' unica per sempre, anche sulle righe concluse, quindi un
/// secondo guasto sulla stessa risorsa a distanza di settimane verrebbe
/// scambiato per un doppione e scartato. Qui la chiave e' la risorsa stessa e
/// la riga si riapre: e' un registro di cose da rimettere a posto, non una
/// fila di lavori da chiamare.
///
/// CHI LE RIPARA. Due strade, e la differenza sta in `recovered_by_delta`. Le
/// riparazioni che il delta riporta da solo (un prodotto, un cliente, un
/// ordine) tengono indietro il confine fino alla loro data di modifica: la
/// corsa dopo se le ritrova davanti senza che nessuno vada a ripescarle. Quelle
/// che il delta non puo' riportare — la data di nascita che va VERSO Shopify,
/// dove non e' cambiato niente da segnalare; la spazzata delle righe non piu'
/// riscritte, che la corsa incrementale non fa — vengono rispinte all'inizio
/// della corsa successiva, che e' il momento in cui il negozio e' gia' aperto e
/// il lucchetto e' gia' nostro.
model SyncRepair {
  id String @id @default(uuid())

  shopId String @map("shop_id")

  /// 'product' | 'customer' | 'order'.
  resourceType String @map("resource_type")

  /// L'id su Shopify, come testo: gli id di Shopify non stanno in un intero, e
  /// la spazzata non ne ha uno (vale la sentinella 'catalogue').
  resourceId String @map("resource_id")

  /// 'upsert' | 'delete' | 'sweep' | 'consent_revoke' | 'birthdate_writeback'.
  operation String

  /// Quando la risorsa e' cambiata su Shopify. E' il dato da cui dipende tutto:
  /// e' fin qui che il confine incrementale viene tenuto indietro, ed e' cosi'
  /// che la corsa dopo ritrova la risorsa nel delta. Nullo quando Shopify non
  /// l'ha detto: allora si torna all'inizio della corsa, che e' la scelta
  /// prudente.
  sourceUpdatedAt DateTime? @map("source_updated_at")

  /// Se il delta della corsa successiva ci ripassa da solo. Falso vuol dire che
  /// la riparazione va spinta: aspettare sarebbe aspettare un evento che non
  /// puo' accadere.
  recoveredByDelta Boolean @default(true) @map("recovered_by_delta")

  /// 'pending' | 'done' | 'dead_letter'.
  status String @default("pending")

  attempts Int @default(0)

  /// Prima di questo istante non si ritenta. E' il distanziamento fra un
  /// tentativo e l'altro: senza, una riparazione impossibile verrebbe ritentata
  /// a ogni corsa contro un servizio che sta ancora male.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")

  /// Cosa serve a ripetere l'operazione, o a capirla guardandola dopo: per una
  /// cancellazione l'elenco degli id, per una spazzata il suo istante di
  /// confine. L'elenco si conserva anche quando la riparazione passera' dal
  /// delta — e' l'unica traccia di cosa era rimasto indietro.
  details Json?

  /// L'ultimo errore, redatto: questa colonna la si legge in un log, e un
  /// messaggio d'errore e' il posto piu' facile del mondo dove far uscire un
  /// segreto senza accorgersene.
  lastError String? @map("last_error")

  /// La corsa che ha trovato il guasto. Nessuna chiave esterna, di proposito:
  /// la riparazione deve sopravvivere alla corsa che l'ha aperta, e una riga
  /// che sparisce insieme al registro si porterebbe via un lavoro non fatto.
  openedByJobId String? @map("opened_by_job_id")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  resolvedAt DateTime? @map("resolved_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Una riga per risorsa e operazione, che si riapre invece di duplicarsi: due
  /// corse che inciampano sullo stesso prodotto descrivono lo stesso lavoro da
  /// fare, non due.
  @@unique([shopId, resourceType, resourceId, operation])
  @@index([shopId, status, nextAttemptAt])
  @@index([openedByJobId])
  @@map("sync_repairs")
}

/// La posta in arrivo dei webhook amministrativi: la ricevuta che si scrive
/// PRIMA di rispondere 200, e il lavoro che ne segue.
///
/// PERCHE' UNA TABELLA E NON UN TIPO NUOVO IN `sync_requests`. Tre motivi, e
/// ognuno da solo basterebbe.
///
/// Il primo e' la presa: la coda lavora ogni item dentro il lucchetto del suo
/// negozio, e una disinstallazione che aspetta il lucchetto aspetta la fine di
/// una sincronizzazione che dura minuti — proprio quella che sta scrivendo per
/// conto di un negozio che ha appena chiuso. Le due cose devono poter accadere
/// nell'ordine opposto.
///
/// Il secondo e' il negozio: `sync_requests.shop_id` punta a `shops`, e questi
/// due webhook arrivano anche per installazioni mai completate e per negozi che
/// non abbiamo mai avuto. Qui il negozio e' un dominio, e l'id si risolve
/// quando si lavora — se si risolve.
///
/// Il terzo e' il corpo: la ricevuta deve conservare l'evento cosi' com'e'
/// arrivato, perche' e' l'unica cosa da cui lo si puo' rifare. La coda porta di
/// proposito il minimo per ritrovare un lavoro, mai il lavoro stesso.
///
/// E' lo stesso ragionamento che ha portato `sync_repairs` fuori dalla coda, e
/// la stessa forma gia' usata da `compliance_requests`. Non e' un'infrastruttura
/// nuova: e' la terza applicazione di quella che c'e'.
model WebhookEvent {
  id String @id @default(uuid())

  /// L'id che Shopify da' alla consegna (header `X-Shopify-Webhook-Id`), o
  /// l'impronta del corpo quando l'header manca. Unico: e' questo indice a
  /// rendere la seconda consegna dello stesso evento una ricevuta invece di un
  /// secondo effetto.
  webhookId String @unique @map("webhook_id")

  /// 'app/uninstalled' | 'app_subscriptions/update'.
  topic String

  /// Il negozio come lo dichiara Shopify. C'e' sempre — l'header e' il solo
  /// dato che si legge prima della ricevuta — anche quando quel negozio da noi
  /// non esiste.
  shopDomain String @map("shop_domain")

  /// Il riferimento interno del negozio, risolto in lavorazione e non alla
  /// ricevuta: la ricevuta non deve dipendere da una lettura in piu'. Resta
  /// nullo per un negozio che non abbiamo mai avuto.
  shopId String? @map("shop_id")

  /// Il corpo verificato, com'e' arrivato. Serve a rifare l'elaborazione tante
  /// volte quante ne servono, e a capire dopo cos'era successo. Non contiene
  /// dati personali: questi due topic parlano di un negozio e di un
  /// abbonamento, non di una persona.
  payload Json?

  /// 'queued' | 'processing' | 'completed' | 'dead_letter'.
  /// Non esiste 'failed', come nella coda: un tentativo andato male torna
  /// 'queued' con `nextAttemptAt` in avanti, cosi' c'e' un posto solo da
  /// guardare per sapere cosa e' pronto.
  status String @default("queued")

  attempts Int @default(0)

  /// Prima di questo istante non si ritenta. E' il distanziamento.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")

  /// L'ultimo errore, redatto: questa colonna finisce in un log, e un messaggio
  /// d'errore e' il posto piu' facile del mondo dove far uscire un segreto
  /// senza accorgersene.
  lastError String? @map("last_error")

  receivedAt  DateTime  @default(now()) @map("received_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Il negozio quando c'e'. `SetNull` e non `Cascade`, come per le richieste
  /// di conformita': l'evento deve sopravvivere alla riga del negozio, perche'
  /// e' anche la prova di cosa era arrivato per un negozio che non c'e' piu'.
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  /// Cosa c'e' da lavorare adesso: e' la query del drenaggio.
  @@index([status, nextAttemptAt])
  @@index([shopDomain, receivedAt(sort: Desc)])
  @@map("webhook_events")
}

/// Il registro durevole delle revoche del tracciamento.
///
/// COSA C'ERA PRIMA. La revoca era best effort da capo a fondo. `forgetVisitor`
/// scriveva un avviso nel log e restituiva 'failed'; le quattro rotte che la
/// chiamano quel risultato non lo guardavano, e rispondevano 200. Il cookie
/// `corew_eid` veniva fatto scadere comunque. Il risultato: l'unico riferimento
/// da cui si sarebbe potuto riprovare — l'identificativo dentro il browser —
/// spariva, mentre nel database del merchant restavano il legame
/// browser-cliente e la riga del visitatore. E non tornava nessuno a
/// riprenderli: il delta dei clienti puo' benissimo non rivedere piu' quel
/// cliente, perche' `updated_at` non cambia una seconda volta.
///
/// PERCHE' UNA TABELLA E NON UN TIPO NUOVO IN `sync_requests`. Quattro motivi,
/// e i primi due da soli basterebbero.
///
/// Il primo e' il segreto. Per riprovare serve l'identificativo del browser,
/// che e' un dato personale: qui sta CIFRATO, con una chiave sua, e si cancella
/// appena il lavoro riesce. `sync_requests.payload` e' un JSON in chiaro, non ha
/// ritenzione propria e porta di proposito il minimo per ritrovare un lavoro,
/// mai il lavoro stesso.
///
/// Il secondo e' la deduplica. Qui la chiave e' un HMAC del soggetto: due
/// revoche identiche devono diventare un lavoro solo SENZA che l'identificativo
/// finisca in chiaro dentro un indice unico, che e' esattamente cio' che
/// succederebbe usando `sync_requests.dedup_key`.
///
/// Il terzo e' la presa: la coda lavora ogni item dentro il lucchetto del suo
/// negozio, e una revoca che aspetta il lucchetto aspetta la fine di una
/// sincronizzazione che dura minuti. Una persona che ha appena detto di no non
/// aspetta la sincronizzazione di un catalogo.
///
/// Il quarto e' `sync_repairs`, che era l'altro candidato: quel registro e'
/// drenato dalla corsa stessa e tiene indietro il confine incrementale finche'
/// una risorsa non e' rimessa a posto. Una revoca non ha niente a che vedere
/// con il confine, e trattenerlo per lei vorrebbe dire far rileggere a ogni
/// corsa una finestra che non c'entra.
///
/// E' quindi la quarta applicazione della stessa forma — ricevuta durevole,
/// tentativi, distanziamento, lettera morta, allarme, replay — non una quinta
/// infrastruttura.
model ConsentRevocation {
  id String @id @default(uuid())

  /// Il negozio nel cui database va applicata. Nullo quando quel negozio non
  /// c'e' piu': la riga resta lo stesso, perche' e' anche la prova che una
  /// revoca era stata presa in carico.
  shopId String? @map("shop_id")

  /// Cosa va disfatto. Elenco chiuso (vedi `REVOCATION_SCOPES`): uno scopo che
  /// nessun processore sa lavorare non deve poter creare una riga che resta in
  /// attesa per sempre.
  scope String

  /// L'identita' della revoca, e l'unica cosa su cui si deduplica: un HMAC di
  /// negozio + scopo + soggetto. Chi apre la tabella non ci legge nessun
  /// identificativo; chi arriva con una domanda precisa — "la revoca di questo
  /// browser e' stata presa in carico?" — puo' ricalcolarlo e trovare la riga.
  /// Verificabile senza essere leggibile, come le impronte GDPR.
  idempotencyKey String @unique @map("idempotency_key")

  /// Il soggetto in chiaro, cifrato. E' l'identificativo del browser, cioe' il
  /// riferimento senza il quale il ritentativo non saprebbe piu' cosa
  /// cancellare — proprio quello che il cookie scaduto porta via dal browser.
  /// Si azzera appena il lavoro riesce: da li' in poi resta la sola prova HMAC.
  subjectCipher String? @map("subject_cipher")

  /// L'id del cliente Shopify, quando la revoca ne nomina uno. Cifrato per la
  /// stessa ragione, e nullo quando non serve: il legame lo si ritrova
  /// dall'identificativo del browser, e un dato in piu' conservato "per
  /// comodita'" e' un dato in piu' da cancellare.
  customerCipher String? @map("customer_cipher")

  /// 'queued' | 'processing' | 'completed' | 'dead_letter'.
  /// Non esiste 'failed', come nella coda e nella posta dei webhook: un
  /// tentativo andato male torna 'queued' con `nextAttemptAt` in avanti.
  status String @default("queued")

  attempts Int @default(0)

  /// Prima di questo istante non si ritenta. E' il distanziamento.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")

  /// Chi ha la riga in mano adesso, e fino a quando. L'identita' e' nuova a
  /// ogni presa, quindi chi ha perso il possesso non puo' piu' chiudere il
  /// lavoro di chi e' subentrato: e' lo stesso effetto del gettone della coda,
  /// ottenuto senza un contatore in piu'.
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")

  /// L'esito passo per passo dell'ultimo tentativo, redatto. Serve a sapere
  /// QUALE dei tre gesti non e' riuscito — slegare il cliente, azzerare i
  /// rimandi, cancellare la riga — senza doverlo dedurre da un messaggio.
  steps Json?

  /// L'ultimo errore, redatto: questa colonna finisce in un log, e un messaggio
  /// d'errore e' il posto piu' facile del mondo dove far uscire un dato
  /// personale senza accorgersene.
  lastError String? @map("last_error")

  requestedAt DateTime  @default(now()) @map("requested_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  /// Quando il testo cifrato e' stato tolto di mezzo. Sulle riuscite e'
  /// l'istante del completamento; sulle abbandonate e' la fine della ritenzione
  /// breve, oltre la quale resta la sola prova.
  subjectPurgedAt DateTime? @map("subject_purged_at")

  /// `SetNull` e non `Cascade`, come per i webhook amministrativi: la revoca
  /// deve sopravvivere alla riga del negozio, perche' e' la prova che una
  /// persona aveva chiesto di non essere piu' riconosciuta.
  shop Shop? @relation(fields: [shopId], references: [id], onDelete: SetNull)

  /// Cosa c'e' da lavorare adesso: e' la query del drenaggio.
  @@index([status, nextAttemptAt])
  @@index([shopId, status])
  @@map("consent_revocations")
}

/// La prova che un negozio e' stato cancellato, e che al negozio sopravvive.
///
/// IL PARADOSSO DA CUI NASCE. `shop/redact` cancella la riga `shops`, e con lei
/// — in cascata — il registro delle sincronizzazioni, che e' dove finiva la
/// traccia di controllo. La prova di aver eseguito la richiesta si
/// autodistruggeva insieme a cio' che doveva provare, e quel che restava era un
/// `console.log`: una riga in un log a ritenzione breve, che nessuna autorita'
/// accetterebbe come dimostrazione di aver cancellato qualcosa.
///
/// PERCHE' UNA TABELLA E NON UN TIPO NUOVO IN `sync_requests`. Un item di coda
/// e' una sveglia, non una prova: si consuma, si pota, e la sua `dedup_key`
/// porterebbe il dominio in chiaro dentro un indice unico. `compliance_requests`
/// non poteva servire per la ragione opposta — quella riga porta il dominio in
/// chiaro ed e' proprio quella che, a cancellazione riuscita, va tolta di mezzo.
/// `sync_jobs` era la casa storica della traccia GDPR ed e' il guasto stesso:
/// ha una chiave esterna in cascata verso `shops`. Serviva un registro senza
/// nessun legame con il negozio, senza nessun dato personale dentro, e con una
/// ritenzione sua. Questo.
///
/// COSA C'E' DENTRO, E NIENTE ALTRO: l'id della consegna, il topic, l'istante,
/// l'esito, i conteggi per tabella, la versione della procedura e l'impronta
/// del negozio. Nessun dominio, nessun id, nessuna email. Un registro di
/// cancellazioni che conserva quello che ha cancellato e' il modo piu' elegante
/// di non aver cancellato niente.
model ShopErasureProof {
  id String @id @default(uuid())

  /// L'id che Shopify da' alla consegna (header X-Shopify-Webhook-Id). Unico:
  /// e' su questo che la seconda consegna della stessa richiesta trova la prova
  /// gia' scritta e si dichiara fatta, invece di andare a cercare un negozio
  /// che non esiste piu' — o peggio, di ricrearlo.
  webhookId String @unique @map("webhook_id")

  /// Il topic della richiesta. Sempre 'shop/redact' oggi; c'e' come colonna
  /// perche' il giorno in cui una seconda richiesta cancellera' un negozio,
  /// leggere la prova non dovra' voler dire indovinare da dove veniva.
  topic String

  /// L'impronta del negozio: un HMAC del dominio con una chiave dedicata.
  ///
  /// A senso unico. Chi apre la tabella non ci legge nessun negozio; chi arriva
  /// con una domanda precisa — "il negozio tal dei tali e' stato cancellato il
  /// 14 marzo?" — puo' ricalcolarla e trovare la riga. Verificabile senza
  /// essere leggibile, come le impronte del registro GDPR e come il soggetto
  /// delle revoche di consenso.
  ///
  /// NON e' unica: lo stesso negozio puo' installare, disinstallare e chiedere
  /// di nuovo la cancellazione, e ognuna di quelle richieste ha diritto alla
  /// sua prova.
  shopRef String @map("shop_ref")

  /// Quale procedura ha prodotto questa prova. Serve a chi legge una riga
  /// vecchia: i conteggi di oggi elencano cinque tabelle, quelli di domani
  /// potrebbero elencarne sei, e senza un numero non si saprebbe se una tabella
  /// mancante e' una che non c'era o una che nessuno ha cancellato.
  procedureVersion Int @map("procedure_version")

  /// 'completed' quando la transazione e' andata in fondo, 'skipped' quando non
  /// c'era nessun negozio da cancellare. Un fallimento qui non si scrive: la
  /// transazione che fallisce annulla anche questa riga, ed e' proprio cosi'
  /// che si evita una prova di cancellazione senza cancellazione.
  outcome String

  /// Quante righe per tabella. E' il contenuto della prova: non "e' stato
  /// fatto", ma cosa e' stato fatto.
  counts Json

  /// La generazione di cancellazione con cui la procedura ha lavorato. Dice a
  /// chi legge che il negozio era stato chiuso alle scritture prima che si
  /// cominciasse, e quale gettone le corse in volo avrebbero dovuto verificare.
  erasureGeneration Int? @map("erasure_generation")

  erasedAt DateTime @default(now()) @map("erased_at")

  /// NESSUNA chiave esterna verso `shops`, e non e' una dimenticanza: e' il
  /// punto di tutta la tabella. Nemmeno `SetNull` andrebbe bene — quella
  /// vorrebbe dire una colonna con l'id del negozio, cioe' un riferimento in
  /// piu' a una cosa che abbiamo appena finito di cancellare. Del negozio qui
  /// resta solo l'impronta.
  @@index([shopRef])
  @@index([erasedAt])
  @@map("shop_erasure_proofs")
}

/// Il registro dell'ambito: per ogni prodotto di cui teniamo dei dati, se
/// continua ad aggiornarsi o se e' fermo, e perche'.
///
/// PERCHE' ESISTE. La corsa completa smetteva di impaginare al tetto del piano e
/// poi eseguiva lo stesso la spazzata globale ("via tutte le righe che questa
/// corsa non ha riscritto"). Quel che stava oltre il tetto non era stato
/// riscritto perche' non era stato nemmeno chiesto: risultava vecchio, e veniva
/// cancellato. Il tetto di un piano deve decidere cosa continua ad aggiornarsi,
/// non cosa esiste — e per poterlo fare serviva un posto dove dire "questa riga
/// e' ferma di proposito", altrimenti "ferma" e "sparita" restano
/// indistinguibili.
///
/// PERCHE' UNA TABELLA E NON UN TIPO NUOVO NELLA CODA. `sync_requests` e' una
/// fila di lavori da chiamare: ogni item costa una presa, un lease e un
/// battito, e qui non c'e' niente da chiamare — non e' un lavoro in attesa, e'
/// uno stato che dura finche' il piano dura. La sua `dedup_key` inoltre e'
/// unica per sempre, mentre qui la stessa risorsa cambia ambito avanti e
/// indietro a ogni cambio di piano. E nemmeno `sync_repairs` andava bene, che
/// pure e' un registro: li' ogni riga e' un guasto da rimettere a posto e la
/// riga esiste per sparire, qui una riga fuori ambito e' il comportamento
/// corretto e non c'e' niente da riparare. Stessa forma, significato opposto.
///
/// PERCHE' NON UNA COLONNA SULLA TABELLA DEL MERCHANT. Perche' e' roba nostra:
/// il merchant nel suo database vuole i suoi prodotti, non la contabilita' del
/// nostro tetto. E perche' un valore scritto li' andrebbe mantenuto allineato
/// da fuori, mentre qui vive nella stessa transazione della decisione che lo
/// produce.
///
/// COSA C'E' DENTRO, E COSA NON C'E'. Ci sono solo i prodotti di cui teniamo
/// davvero dei dati: chi non e' mai entrato nell'ambito non ha righe da
/// proteggere e non ha niente di fermo da dichiarare — lo conta gia' l'avviso
/// del tetto raggiunto. Cosi' la tabella resta grande quanto il catalogo
/// sincronizzato, non quanto il catalogo.
model ProductScopeEntry {
  id String @id @default(uuid())

  shopId String @map("shop_id")

  /// L'id su Shopify, come testo: stessa scelta di `sync_repairs`, e per la
  /// stessa ragione — gli id di Shopify sono numeri grandi che nessuno usa per
  /// fare aritmetica.
  shopifyProductId String @map("shopify_product_id")

  /// La data di creazione su Shopify: e' la chiave della graduatoria. Sta qui e
  /// non si ricalcola ogni volta perche' e' cio' che rende la scelta ripetibile
  /// — senza, "i primi N" dipenderebbe da quali pagine si sono viste.
  sourceCreatedAt DateTime? @map("source_created_at")

  /// Quando questa risorsa e' entrata nell'ambito la prima volta. Non si
  /// riscrive: serve a raccontare da quanto il merchant ha quei dati, e
  /// aggiornarla a ogni corsa la ridurrebbe a un duplicato di `last_checked_at`.
  firstScopedAt DateTime @default(now()) @map("first_scoped_at")

  /// Se continua ad aggiornarsi.
  inScope Boolean @default(true) @map("in_scope")

  /// 'in_scope' | 'plan_quota'. Il motivo si scrive anche quando e' "nessuno":
  /// una colonna che vale qualcosa solo a volte si legge male, e un domani i
  /// motivi per fermare una risorsa saranno piu' d'uno.
  reason String @default("in_scope")

  /// L'ultima corsa che ha verificato questa risorsa: dice se il registro e'
  /// aggiornato, e distingue una riga ferma da una riga dimenticata.
  lastCheckedAt DateTime @default(now()) @map("last_checked_at")

  /// L'ultima volta che e' stata aggiornata mentre era dentro l'ambito. Su una
  /// riga ferma e' la data del dato che il merchant sta guardando, ed e' il
  /// numero che l'interfaccia mostra per non far passare per fresco un dato che
  /// non lo e'.
  lastInScopeAt DateTime? @map("last_in_scope_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  /// Una riga per prodotto: l'ambito e' uno stato, non una storia.
  @@unique([shopId, shopifyProductId])
  @@index([shopId, inScope])
  @@map("product_scope")
}
