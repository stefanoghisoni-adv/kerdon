{
  "name": "kerdon",
  "version": "1.0.0",
  "description": "CoreWard - Shopify app for syncing products and customers to merchant Supabase databases",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "shopify app dev",
    "build": "prisma generate && remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "worker": "tsx watch worker.ts",
    "queue:replay": "tsx scripts/queue-replay.ts",
    "repairs:replay": "tsx scripts/repairs-replay.ts",
    "webhooks:replay": "tsx scripts/webhooks-replay.ts",
    "consent:replay": "tsx scripts/consent-replay.ts",
    "worker:build": "node build-worker.mjs",
    "build:verified": "prisma generate && npm run typecheck && vitest run && npm run build",
    "audit:gate": "node scripts/audit-gate.mjs",
    "sbom": "npm sbom --sbom-format=cyclonedx > sbom.cyclonedx.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@remix-run/serve": "^2.17.5",
    "@shopify/app-bridge-react": "^4.2.11",
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-viz": "^16.16.0",
    "@shopify/shopify-app-remix": "^4.2.1",
    "@shopify/shopify-app-session-storage-prisma": "^9.0.1",
    "@supabase/supabase-js": "^2.110.2",
    "@vercel/functions": "^3.7.5",
    "bullmq": "^5.80.1",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "isbot": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^3.2.4",
    "esbuild": "0.28.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "tar": "^7.5.22",
    "qs": "^6.16.0",
    "estree-util-value-to-estree": "^3.3.3",
    "toml": "^4.3.0",
    "deepmerge-ts": "^8.0.2"
  }
}
