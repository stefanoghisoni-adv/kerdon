# Shopify
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
# Deve ripetere parola per parola `scopes` di shopify.app.toml, che e' la fonte
# di verita': se le due divergono, l'app chiede un consenso diverso da quello che
# il Partner Dashboard mostra al merchant.
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_customers,write_customers,read_publications,read_themes,read_orders,read_all_orders
SHOPIFY_APP_URL=http://localhost:3000
SHOPIFY_API_VERSION=2026-07
# Optional: set only when testing against a custom shop domain (e.g. ngrok/tunnel)
# SHOP_CUSTOM_DOMAIN=

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/shopify_sync

# Redis — solo la cache delle statistiche. La coda dei lavori sta su Postgres
# (vedi docs/architecture/queue-adr.md): qui non passa.
REDIS_URL=redis://localhost:6379

# Security
ENCRYPTION_SECRET=generate_256_bit_key_here
SESSION_SECRET=generate_random_string_here
# Opzionale: la chiave con cui si firmano le impronte nelle tracce di controllo
# GDPR. Se assente viene derivata da ENCRYPTION_SECRET, quindi non serve
# impostarla: si mette solo per poterla ruotare da sola, senza toccare la chiave
# con cui sono cifrati i token dei negozi. Cambiandola, le impronte gia' scritte
# restano verificabili solo con la chiave di allora.
# GDPR_AUDIT_SECRET=

# Supabase OAuth (richiesto per il flusso "Collega Supabase" via OAuth)
# Registrare una OAuth App su Supabase (Organization settings -> OAuth Apps),
# redirect URL = ${SHOPIFY_APP_URL}/auth/supabase/callback
SUPABASE_OAUTH_CLIENT_ID=your_supabase_oauth_client_id
SUPABASE_OAUTH_CLIENT_SECRET=your_supabase_oauth_client_secret

# Billing
# true = gli abbonamenti nascono come addebiti di prova anche su un negozio
# normale: serve a provare l'attivazione dei piani senza pagare davvero. Sui
# negozi di sviluppo l'app lo fa gia' da se'. In produzione va lasciata assente.
SHOPIFY_BILLING_TEST=false

# Cron
CRON_SECRET=generate_random_secret_here
