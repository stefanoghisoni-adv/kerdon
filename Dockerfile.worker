# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Copia i file di package e lo schema Prisma PRIMA di npm ci: cosi' Docker
# riutilizza il layer se le dipendenze non cambiano, e prisma generate puo'
# girare subito dopo l'install.
COPY package*.json ./
COPY prisma/schema.prisma ./prisma/

# Installa tutte le dipendenze (non --production: servono anche le devDependencies
# per compilare TypeScript). Il flag --legacy-peer-deps e' necessario per i
# conflitti di peer dependency noti del progetto.
RUN npm ci --legacy-peer-deps

# Genera il client Prisma: va dopo npm ci perche' serve @prisma/client installato,
# e prima della copia del codice cosi' il layer si riutilizza se solo il codice
# cambia ma lo schema no.
RUN npx prisma generate

# Copia tutto il resto del codice sorgente.
COPY . .

# Compila il worker TypeScript in JavaScript. Il build produce ./dist/worker.js
# che e' il file che il container di produzione eseguira'. Se il worker importa
# moduli dall'app, questi vengono compilati insieme.
RUN npm run worker:build

# Stage 2: Production
FROM node:22-alpine

WORKDIR /app

# Copia i file di package e lo schema Prisma per installare solo le dipendenze
# di produzione e rigenerare il client Prisma.
COPY package*.json ./
COPY prisma/schema.prisma ./prisma/

# Installa solo le dipendenze di produzione: il worker compilato non ha bisogno
# di TypeScript o altri devDependencies. Il flag --legacy-peer-deps resta
# necessario anche qui.
RUN npm ci --production --legacy-peer-deps

# Rigenera il client Prisma nello stage di produzione: il client generato nello
# stage di build non si puo' copiare perche' contiene percorsi assoluti che
# puntano alla directory di build.
RUN npx prisma generate

# Copia il worker compilato (JavaScript) dallo stage di build. Non servono i
# sorgenti TypeScript: il container esegue il .js gia' compilato.
COPY --from=builder /app/dist ./dist

# Il worker compilato e' un modulo ES (type: "module" in package.json), quindi
# Node lo esegue direttamente senza bisogno di tsx o altri loader.
CMD ["node", "dist/worker.js"]
