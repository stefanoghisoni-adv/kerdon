# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Copia i file di package e lo schema Prisma PRIMA di npm ci: cosi' Docker
# riutilizza il layer se le dipendenze non cambiano, e prisma generate puo'
# girare subito dopo l'install.
COPY package*.json ./
COPY prisma/schema.prisma ./prisma/

# Installa tutte le dipendenze (non --production: servono anche le devDependencies
# per costruire il fascio del worker). Il flag --legacy-peer-deps e' necessario
# per i conflitti di peer dependency noti del progetto.
RUN npm ci --legacy-peer-deps

# Genera il client Prisma. Non serve un DATABASE_URL: `generate` legge lo schema
# e scrive dei file, non si collega a niente.
RUN npx prisma generate

# Copia il resto del codice sorgente. Cosa resta fuori lo decide .dockerignore,
# e la riga che conta li' e' `node_modules`: senza, il node_modules di macOS
# della macchina di sviluppo verrebbe copiato sopra quello Linux appena
# installato, e il motore di Prisma non partirebbe piu'.
COPY . .

# Impacchetta il worker in un solo file JavaScript (dist/worker.js) insieme ai
# moduli dell'app che usa. Restano fuori i pacchetti con dipendenze native, che
# nello stage di produzione ci sono gia'.
RUN npm run worker:build

# Stage 2: Production
FROM node:22-alpine

WORKDIR /app

# Copia i file di package e lo schema Prisma per installare solo le dipendenze
# di produzione.
COPY package*.json ./
COPY prisma/schema.prisma ./prisma/

# Installa solo le dipendenze di produzione: il worker impacchettato non ha
# bisogno delle devDependencies. Il flag --legacy-peer-deps resta necessario.
RUN npm ci --production --legacy-peer-deps

# Il client Prisma generato arriva dallo stage di build invece di essere
# rigenerato qui. Rigenerarlo era il modo lento di ottenere lo stesso file: i
# percorsi assoluti che il client si porta dentro puntano a /app, che e' la
# WORKDIR di entrambi gli stage, quindi copiarlo va bene.
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copia il worker impacchettato dallo stage di build.
COPY --from=builder /app/dist ./dist

# Il worker impacchettato e' un modulo ES (type: "module" in package.json),
# quindi Node lo esegue direttamente senza tsx o altri loader.
CMD ["node", "dist/worker.js"]
